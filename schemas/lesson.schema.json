{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edu-animation-framework/lesson.schema.json",
  "title": "Lesson Specification",
  "description": "Contract for lesson.json files under lessons/. A lesson describes educational intent only — renderer-specific details (Blender objects, keyframes, coordinates) are prohibited here. Validation is currently enforced by tools/validate.mjs.",
  "type": "object",
  "required": [
    "id",
    "title",
    "subject",
    "grade",
    "curriculum",
    "learningObjectives",
    "scenes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$",
      "description": "Dotted identifier, e.g. chemistry.magnesium-ribbon."
    },
    "title": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "string",
      "enum": ["chemistry", "physics", "biology", "mathematics"]
    },
    "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
    "curriculum": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["foundation", "draft", "reviewed", "final"]
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "purpose": { "type": "string", "minLength": 1 },
          "assets": {
            "type": "array",
            "description": "Asset ids referenced by this scene. The validator checks that every referenced id exists in the assets/ registry.",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          },
          "equation": { "type": "string" }
        }
      }
    }
  }
}
